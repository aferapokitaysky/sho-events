# Server Configuration
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
ADMIN_TOKEN=your-super-secret-admin-token

# Admin panel login (/admin on the site)
# Generate a hash with: node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');c.scrypt('YOUR_PASSWORD',s,64,(e,k)=>console.log(s+':'+k.toString('hex')))"
ADMIN_USERNAME=anna
ADMIN_PASSWORD_HASH=salt:hash
ADMIN_JWT_SECRET=generate-a-long-random-string

# Telegram Bot Funnel Notifications
# Create a bot via @BotFather on Telegram and paste the token below:
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Chat ID of the Telegram admin, group, or channel where lead alerts should be delivered:
# (You can get your Chat ID by forwarding a message to @userinfobot or @raw_data_bot)
TELEGRAM_CHAT_ID=-100123456789

# Optional: If you use a Telegram Supergroup with Threads/Topics, specify the Thread ID here:
# TELEGRAM_TOPIC_ID=1
